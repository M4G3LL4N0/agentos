[Unit]
Description=AgentOS Core HTTP API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agentos
Group=agentos
WorkingDirectory=/opt/agentos/current
StateDirectory=agentos
StateDirectoryMode=0750
Environment=AGENTOS_HOME=/var/lib/agentos
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/agentos/agentos.env
ExecStart=/opt/agentos/venv/bin/agentos serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
