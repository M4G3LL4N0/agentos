#!/bin/bash
# AgentOS production backup (Phase 3 §7).
# Layer 1 (DR): full-file DB via SQLite backup API + config/loop_state/contracts.
# Layer 2 (portable): sanitized secrets-excluded export via the core CLI.
# Never deletes anything except aged backup archives beyond retention.
set -euo pipefail

STATE_DIR="${AGENTOS_HOME:-/var/lib/agentos}"
CONFIG_DIR="${AGENTOS_CONFIG_DIR:-/etc/agentos}"
BACKUP_DIR="${AGENTOS_BACKUP_DIR:-/var/backups/agentos}"
RETENTION="${AGENTOS_BACKUP_RETENTION:-14}"
TS=$(date -u +%Y%m%dT%H%M%SZ)

mkdir -p "$BACKUP_DIR"

# --- Layer 1: DR full-file snapshot (consistent under concurrency) ---
STAGING=$(mktemp -d /tmp/agentos-dr.XXXXXX)
trap 'rm -rf "$STAGING"' EXIT

python3 - "$STATE_DIR/agentos.db" "$STAGING/agentos.db" <<'PY'
import sqlite3
import sys

src = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
dst = sqlite3.connect(sys.argv[2])
with dst:
    src.backup(dst)
integrity = dst.execute("PRAGMA integrity_check").fetchone()[0]
src.close()
dst.close()
if integrity != "ok":
    raise SystemExit(f"integrity check failed: {integrity}")
print("dr-db-backup ok")
PY

cp -a "$STATE_DIR/loop_state.json" "$STAGING/" 2>/dev/null || true
cp -a "$STATE_DIR/loop_limits.json" "$STAGING/" 2>/dev/null || true
cp -a "$CONFIG_DIR/config.json" "$STAGING/" 2>/dev/null || true
if [ -d "$STATE_DIR/contracts" ]; then
    cp -a "$STATE_DIR/contracts" "$STAGING/"
fi

DR_ARCHIVE="$BACKUP_DIR/dr-$TS.tar.gz"
tar -czf "$DR_ARCHIVE" -C "$STAGING" .
DR_BYTES=$(stat -c%s "$DR_ARCHIVE")
DR_SHA=$(sha256sum "$DR_ARCHIVE" | cut -d' ' -f1)
echo "$TS,dr,$DR_ARCHIVE,$DR_BYTES,$DR_SHA" >> "$BACKUP_DIR/ledger.csv"

# --- Layer 2: portable export (core CLI, wrapper supplies env) ---
/usr/local/bin/noaerth agentos backup create --output-dir "$BACKUP_DIR" >/dev/null
PORTABLE=$(ls -1t "$BACKUP_DIR"/agentos_backup_*.tar.gz 2>/dev/null | head -1 || true)
if [ -n "$PORTABLE" ]; then
    PB=$(basename "$PORTABLE")
    echo "$(date -u +%Y%m%dT%H%M%SZ),portable,$PORTABLE,$(stat -c%s "$PORTABLE")," >> "$BACKUP_DIR/ledger.csv"
fi

# --- retention: keep newest RETENTION of each layer ---
ls -1t "$BACKUP_DIR"/dr-*.tar.gz 2>/dev/null | tail -n +$((RETENTION + 1)) | xargs -r rm --
ls -1t "$BACKUP_DIR"/agentos_backup_*.tar.gz 2>/dev/null | tail -n +$((RETENTION + 1)) | xargs -r rm --

echo "backup done ts=$TS dr=$DR_ARCHIVE portable=${PORTABLE:-none}"
